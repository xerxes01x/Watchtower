# Core
# "development" (default) allows no-auth dev mode when NEXTAUTH_SECRET is unset.
# Set to "production" to enforce fail-closed checks: the API refuses to start
# without NEXTAUTH_SECRET or with the default database credentials.
ENVIRONMENT=development
LOG_LEVEL=INFO
PROMETHEUS_METRICS_PATH=/metrics

# Server binding (used by `python main.py`; Docker uses the Dockerfile CMD)
API_HOST=0.0.0.0
API_PORT=8000
# Port the Celery worker exposes Prometheus metrics on.
# Must match the worker target in infra/prometheus/prometheus.yml.
WORKER_METRICS_PORT=8001

# Security
# Set a strong token in production.
API_AUTH_TOKEN=change-me
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ALGORITHM=HS256

# Celery / Redis
# Hosts default to the Docker Compose service name `redis`. Each concern uses a
# separate Redis logical DB index (/0../3) — preserve the split when overriding.
# In production, point these at your managed Redis (e.g. rediss://user:pass@host:6380/0).
REDIS_URL=redis://redis:6379/0                # general cache / app use (DB 0)
CELERY_BROKER_URL=redis://redis:6379/1        # Celery task broker (DB 1)
CELERY_RESULT_BACKEND=redis://redis:6379/2    # Celery result backend (DB 2)
CELERY_ALWAYS_EAGER=false
WORKER_CONCURRENCY=4
SCHEDULER_POLL_INTERVAL_SECONDS=30

# Request defaults
DEFAULT_REQUEST_TIMEOUT=10
DEFAULT_LATENCY_MS_THRESHOLD=1500

# Alerts
RESULT_WEBHOOK_URL=

# Observability
SENTRY_DSN=

# Database
# Host defaults to the Docker Compose service name `db`. In production, point at
# your managed Postgres, e.g. postgresql+psycopg2://user:pass@host:5432/dbname
# (the app also accepts the legacy postgres:// scheme; Alembic normalises it).
# In production DATABASE_URL must NOT use the default watchtower:watchtower creds
# or the API will refuse to start.
DATABASE_URL=postgresql+psycopg2://watchtower:watchtower@db:5432/watchtower
AUTO_CREATE_DB=false

# Credentials for the BUNDLED Postgres container (docker-compose `db` service).
# Ignored when you point DATABASE_URL at an external/managed database.
# If you change these, update DATABASE_URL to match — they are not auto-linked.
POSTGRES_DB=watchtower
POSTGRES_USER=watchtower
POSTGRES_PASSWORD=watchtower

# Frontend / NextAuth (loaded by docker-compose into the frontend + app services)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
NEXTAUTH_SECRET=
# Public base URL of the frontend (used by NextAuth for OAuth callbacks).
NEXTAUTH_URL=http://localhost:3001
# Base URL the browser uses to reach the FastAPI backend.
# In production set this to your public API origin, e.g. https://api.example.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_ID=
GITHUB_SECRET=

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3001

# Rate limiter Redis DB (per-tenant slowapi counters, DB 3 — kept separate
# from the broker/result stores so a flush of one never affects the others).
RATE_LIMIT_REDIS_URL=redis://redis:6379/3
